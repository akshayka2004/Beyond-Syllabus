{
  "name": "beyond-syllabus",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "oxlint",
    "dev": "turbo dev",
    "build": "turbo build",
    "generate": "bun run ./apps/server/src/routes/syllabus/generate.ts",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "start:server": "turbo -F server start",
    "test": "turbo test"
  },
  "dependencies": {},
  "devDependencies": {
    "oxlint": "^1.8.0",
    "turbo": "^2.5.4"
  },
  "packageManager": "bun@1.2.12"
}
